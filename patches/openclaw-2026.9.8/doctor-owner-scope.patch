@@ -0,0 +1,32 @@
+import { expect, it, vi } from "vitest";
+import * as snapshots from "../infra/sqlite-snapshot-source.js";
+import { createOpenClawDatabaseMaintenanceScope } from "../state/openclaw-state-db-async-lifecycle.js";
+import { openOpenClawStateDatabase } from "../state/openclaw-state-db.js";
+import { setupDoctorAdmissionFixture } from "./doctor-maintenance.admission.test-support.js";
+import { createDoctorMaintenanceState } from "./doctor-maintenance-state.js";
+import { acquireDoctorGatewayMaintenanceOwner } from "./doctor-maintenance-foreground.js";
+vi.mock("./doctor-maintenance-foreground.js", () => ({acquireDoctorGatewayMaintenanceOwner: vi.fn()}));
+const fixture=setupDoctorAdmissionFixture();
+it("retains the native Doctor reader across the nested gateway owner scope", async()=>{
+ const {env,admission,assertIsolation}=fixture();
+ const ownerScope=createOpenClawDatabaseMaintenanceScope({schemaMaintenance:true});
+ const assertCurrent=vi.fn();
+ vi.mocked(acquireDoctorGatewayMaintenanceOwner).mockResolvedValue({
+  lockPath:"unused-test-owner",run:ownerScope.run,assertCurrent,
+  assertDatabaseAccess:()=>{},release:async()=>{await ownerScope.close();}
+ } as Awaited<ReturnType<typeof acquireDoctorGatewayMaintenanceOwner>>);
+ const state=createDoctorMaintenanceState({params:{runtime:{log:()=>{},error:()=>{},exit:()=>{}}},env,signal:new AbortController().signal,deadline:()=>undefined,assertReadCurrent:admission,settle:async operation=>operation(),warn:()=>{}});
+ await state.acquire();
+ const hashes=vi.spyOn(snapshots,"readSqliteSourceContentVersionSync");
+ try {
+  state.resources!.run(()=>{
+   openOpenClawStateDatabase({env});
+   state.resources!.assertAdmission();hashes.mockClear();
+   state.resources!.assertAdmission();state.resources!.assertAdmission();
+   expect(hashes).not.toHaveBeenCalled();expect(assertCurrent).toHaveBeenCalled();
+   assertCurrent.mockImplementation(()=>{throw new Error("lost maintenance owner");});
+   expect(()=>state.resources!.assertAdmission()).toThrow("lost maintenance owner");
+   assertCurrent.mockReset();
+  });
+ }finally{await state.release();assertIsolation();}
+});